# Frontend-safe Supabase configuration.
# Copy these values from the existing deployment/environment configuration.
# Do not put server-side secrets (service_role, OPENAI_API_KEY, GEMINI_API_KEY, OAuth client secrets) in VITE_* variables.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
